  "expected_detection": {
    "should_alert_on": "attack_sequence",
    "should_not_alert_on": "benign_similar",
    "key_fields": [
      "process.executable",
      "process.name",
      "process.parent.name",
      "user.name",
      "user.domain"
    ],
    "notes": "Detection focus: process.executable path anomaly — a service-named binary (svc*.exe, *updater.exe) executing from C:\\Users\\*\\AppData\\Local\\Temp\\ instead of System32 or Program Files. Key discriminators: (1) process.executable contains \\AppData\\Local\\Temp\\ for a service-like binary name, (2) process.parent.name is explorer.exe rather than services.exe or svchost.exe, (3) user.name is an interactive domain user rather than SYSTEM or NT AUTHORITY. Benign update binaries run from Program Files or System32, are spawned by services.exe or svchost.exe, and run under SYSTEM. Sigma wildcard: process.executable matches *\\AppData\\Local\\Temp\\* AND (process.name matches svc*.exe OR *updater*.exe OR *service*.exe) AND NOT process.parent.name in (services.exe, svchost.exe)."
  },
