process.executable IN ("*\\ProgramData\\*", "*\\AppData\\Local\\*", "*\\AppData\\Roaming\\*", "*\\Users\\Public\\*") process.command_line IN ("*--collect*", "*--out*", "*--sync*", "*--copy*") NOT (process.executable IN ("*\\ProgramData\\Microsoft\\*", "*\\ProgramData\\Windows\\*")) | table process.name,process.executable,process.command_line,process.parent.name,process.parent.executable,user.name
