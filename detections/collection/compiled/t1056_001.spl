event.code="7" file.name="user32.dll" process.executable IN ("*\\AppData\\*", "*\\ProgramData\\*", "*\\Temp\\*", "*\\Users\\Public\\*") NOT (process.name IN ("osk.exe", "narrator.exe", "magnify.exe", "Utilman.exe")) | table process.name,process.executable,file.name,process.parent.name,user.name,host.name
