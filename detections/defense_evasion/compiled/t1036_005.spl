process.executable IN ("*\\AppData\\Local\\Temp\\*", "*\\AppData\\Roaming\\*", "*\\Users\\Public\\*") process.name IN ("*svc*", "*service*", "*update*", "*helper*") NOT (process.name IN ("MicrosoftEdgeUpdate.exe", "MicrosoftEdgeUpdateSetup.exe", "wuauclt.exe", "SgrmBroker.exe")) | table process.name,process.executable,process.command_line,process.parent.name,process.parent.executable,user.name
