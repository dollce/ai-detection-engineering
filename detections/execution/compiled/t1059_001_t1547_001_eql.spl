(event.code="1" process.name IN ("powershell.exe", "pwsh.exe") process.command_line IN ("*-ExecutionPolicy Bypass*", "*-ExecutionPolicy bypass*", "*-ep Bypass*", "*-ep bypass*", "*-EncodedCommand*", "*-enc *", "*-NonInteractive*")) OR (event.code="13" process.name IN ("powershell.exe", "pwsh.exe") registry.path IN ("*\\CurrentVersion\\Run\\*", "*\\CurrentVersion\\RunOnce\\*", "*\\CurrentVersion\\RunServices\\*"))