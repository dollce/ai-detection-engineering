event.code="10" winlog.event_data.GrantedAccess IN ("0x1438", "0x1430", "0x143a") winlog.event_data.TargetImage IN ("*\\svchost.exe", "*\\explorer.exe", "*\\RuntimeBroker.exe") process.executable IN ("*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*") NOT (process.executable IN ("C:\\Windows\\System32\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*")) NOT (process.name IN ("WerFault.exe", "MsMpEng.exe")) | table process.name,process.executable,winlog.event_data.GrantedAccess,winlog.event_data.TargetImage,user.name,host.name
