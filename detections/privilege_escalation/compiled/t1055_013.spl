event.code="10" winlog.event_data.GrantedAccess="0x1FFFFF" winlog.event_data.TargetImage="*\\conhost.exe" process.executable IN ("*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*") NOT (process.executable IN ("C:\\Windows\\System32\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*")) | table process.name,process.executable,winlog.event_data.GrantedAccess,winlog.event_data.TargetImage,user.name,host.name
