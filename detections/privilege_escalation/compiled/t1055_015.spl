(event.code="10" winlog.event_data.GrantedAccess="0x1FFFFF" winlog.event_data.TargetImage="*\\svchost.exe") OR (event.code="8" winlog.event_data.TargetImage="*\\svchost.exe") process.executable IN ("*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*") NOT (process.name IN ("MsMpEng.exe", "MpCmdRun.exe")) NOT (process.executable IN ("C:\\Windows\\System32\\*", "C:\\Program Files\\*", "C:\\Program Files (x86)\\*")) | table process.name,process.executable,winlog.event_data.GrantedAccess,winlog.event_data.TargetImage,user.name,host.name