((event.code:1 AND process.name:net.exe AND process.command_line:(*user*)) OR (event.code:1 AND process.name:net1.exe AND process.command_line:(*user*)) OR (event.code:1 AND process.name:wmic.exe AND process.command_line:(*useraccount*)) OR (event.code:1 AND process.name:(net.exe OR net1.exe) AND process.command_line:(*localgroup*))) AND (NOT (process.parent.executable:(C\:\\Windows\\System32\\svchost.exe* OR C\:\\Windows\\System32\\services.exe*) AND user.name:SYSTEM)) AND (NOT process.parent.executable:(*ccmexec* OR *CcmExec*))
