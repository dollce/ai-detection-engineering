(event.code="1" process.name="tasklist.exe") OR (event.code="1" process.name="wmic.exe" process.command_line IN ("*process list*", "*process get*", "*process where*")) process.parent.executable IN ("*\\AppData\\*", "*\\Temp\\*", "*\\ProgramData\\*", "*\\Users\\Public\\*") NOT (process.parent.name IN ("CcmExec.exe", "msiexec.exe", "svchost.exe", "services.exe")) NOT user.domain="NT AUTHORITY" | table process.name,process.command_line,process.parent.name,process.parent.executable,user.name,host.name
