(event.code="1" process.name="wmic.exe" process.command_line="*securitycenter2*" process.command_line="*antivirusproduct*") OR (event.code="1" process.name IN ("powershell.exe", "pwsh.exe") process.command_line="*Get-MpPreference*") OR (event.code="1" process.name="sc.exe" process.command_line IN ("*query windefend*", "*query MBAMService*", "*query CylanceSvc*", "*query CSFalconService*", "*query SentinelAgent*")) NOT (process.parent.executable="C:\\Windows\\System32\\*" user.name="SYSTEM") | table process.name,process.command_line,process.parent.name,process.parent.executable,user.name,host.name
