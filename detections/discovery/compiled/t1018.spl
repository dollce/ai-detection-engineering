(process.name="*net.exe" process.command_line="*/domain*") OR (process.name="*nltest.exe" process.command_line="*/dclist*") NOT (process.parent.executable IN ("*\\cmd.exe", "*\\powershell.exe", "*\\pwsh.exe", "*\\explorer.exe", "*\\CcmExec.exe", "*\\svchost.exe", "*\\mmc.exe", "*\\conhost.exe", "*\\wt.exe")) | table process.name,process.command_line,process.parent.name,process.parent.executable,user.name,host.name
